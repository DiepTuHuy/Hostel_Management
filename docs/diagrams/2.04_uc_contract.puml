@startuml UC_Contract
title Hình 2.4 — Use Case nhóm C: Quản lý hợp đồng & khách thuê

skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam packageStyle rectangle
skinparam ArrowColor #34507A
skinparam usecase {
  BackgroundColor #E6F5EA
  BorderColor #2E7D32
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #3A5BC7
}
left to right direction

actor "Quản lý"     as Manager
actor "Khách thuê"  as Tenant

rectangle "C. Hợp đồng & Khách thuê" {
  usecase "UC15 — Thêm hồ sơ khách"            as C1
  usecase "UC16 — Lập hợp đồng thuê"           as C2
  usecase "UC17 — Ký số / Xác nhận hợp đồng\n(giả lập — đổi trạng thái)" as C3
  usecase "UC18 — Gia hạn hợp đồng"            as C4
  usecase "UC19 — Sửa đổi hợp đồng"            as C5
  usecase "UC20 — Chấm dứt hợp đồng\n/ Trả phòng" as C6
  usecase "Xem hợp đồng\nđang hiệu lực"        as C7
}

Manager -- C1
Manager -- C2
Manager -- C4
Manager -- C5
Manager -- C6
Tenant  -- C3
Tenant  -- C7

C2 ..> C3 : <<include>>

@enduml
