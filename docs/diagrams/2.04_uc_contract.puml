@startuml UC_Contract
title Hình 2.4 — Sơ đồ Use Case 3: Quản lý hợp đồng & khách thuê

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F5F7FB
  BorderColor #3A5BC7
}

actor "Quản lý"     as Manager
actor "Khách thuê"  as Tenant

rectangle "Quản lý hợp đồng & khách thuê" {
  usecase "UC15 - Thêm hồ sơ khách"           as C1
  usecase "UC16 - Lập hợp đồng thuê"          as C2
  usecase "UC17 - Ký số / Xác nhận\nhợp đồng" as C3
  usecase "UC18 - Gia hạn hợp đồng"           as C4
  usecase "UC19 - Sửa đổi hợp đồng"           as C5
  usecase "UC20 - Chấm dứt hợp đồng\n/ Trả phòng" as C6
  usecase "Xem hợp đồng đang hiệu lực"        as C8
}

Manager -- C1
Manager -- C2
Manager -- C4
Manager -- C5
Manager -- C6
Tenant  -- C3
Tenant  -- C8

C2 ..> C3 : <<include>>

@enduml
