@startuml Act_Room
title Hình 2.8 — Hoạt động: Quản lý phòng (Thêm / Sửa / Trạng thái / Tài sản / Xoá)

skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #34507A
skinparam activity {
  BackgroundColor #FFF6E5
  BorderColor #E59300
  DiamondBackgroundColor #EAF1FB
  DiamondBorderColor #3A5BC7
  StartColor #2E7D32
  EndColor #AD1457
}

|#FFF9EC|Quản lý|
start
:Đăng nhập /manager;
:Chọn cơ sở từ dropdown\n(Branch Switcher);

|#EAF1FB|Frontend React|
:Lưu propertyId vào localStorage;
:GET /api/rooms?propertyId=...;
:Hiển thị sơ đồ phòng theo tầng\n(thẻ KPI + lưới phòng);

|Quản lý|
:Chọn thao tác;
switch (Loại thao tác?)
case (Thêm phòng)
  :Nhập số phòng, tầng,\nloại phòng, giá thuê;
  :POST /api/rooms;
case (Sửa phòng)
  :Chỉnh thông tin phòng;
  :PUT /api/rooms/:id;
case (Đổi trạng thái)
  :Chọn trạng thái mới\n(empty/rented/deposit/maintenance);
  :PATCH /api/rooms/:id/status;
case (Quản lý tài sản)
  :Thêm/sửa taiSan[] (embedded);
  :PUT /api/rooms/:id;
case (Xoá phòng)
  :Xác nhận xoá;
  :DELETE /api/rooms/:id;
endswitch

|#EAF1FB|Backend Express|
if (Dữ liệu hợp lệ?) then (có)
  :Cập nhật MongoDB;
  :Cập nhật Property.tongSoPhong\n/ soPhongDaThue nếu cần;
  :Trả Room đã mapRoom();
else (không)
  :Trả lỗi 400 + thông báo;
endif

|Frontend React|
:Hiển thị Toast;
:Reload danh sách phòng;
stop

@enduml
