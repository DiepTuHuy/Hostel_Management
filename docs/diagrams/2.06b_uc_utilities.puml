@startuml UC_Utilities
title Hình 2.6b — Sơ đồ Use Case 6: Tiện ích bổ trợ

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F5F7FB
  BorderColor #3A5BC7
}

actor "Chủ trọ"        as Owner
actor "Quản lý"        as Manager
actor "Khách thuê"     as Tenant
actor "Khách vãng lai" as Visitor
actor "Gemini API"     as Gemini <<system>>

rectangle "Tiện ích bổ trợ (Nhắc nợ, Tìm kiếm, Đặt cọc & AI Chatbot)" {
  usecase "UC37 - Gửi thông báo\n& nhắc nợ"             as UT1
  usecase "UC38 - Tìm kiếm phòng\n(dạng danh sách)"      as UT2
  usecase "UC39 - Đặt cọc phòng\ntrực tuyến"            as UT3
  usecase "UC41 - Trợ lý ảo AI Chatbot\n(BoardingHouse AI)" as UT5

  usecase "Tra cứu trực tuyến\n(online LLM)"            as UT6
  usecase "Tra cứu ngoại tuyến\n(offline fallback)"     as UT7
}

Owner   -- UT1
Owner   -- UT5

Manager -- UT1
Manager -- UT5

Tenant  -- UT2
Tenant  -- UT5

Visitor -- UT2
Visitor -- UT3
Visitor -- UT5

UT5 ..> UT6 : <<extend>>
UT5 ..> UT7 : <<extend>>
UT6 -- Gemini

@enduml
