@startuml ClassDiagram
title Hình 2.12 — Sơ đồ lớp tổng thể (Phiên bản triển khai NoSQL — MongoDB Atlas)

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

' ========== PACKAGE 1: NGƯỜI DÙNG & VAI TRÒ ==========
package "1. Người dùng & Vai trò" #E8EEF9 {

  class User {
    + _id : ObjectId
    + hoTen : String
    + email : String  <<unique>>
    + matKhau : String  <<bcrypt>>
    + sdt : String
    + vaiTro : enum {admin, manager, tenant}
    + trangThai : enum {active, inactive, locked, pending}
    + maNhaTroIds : ObjectId[]   <<N–N với Property>>
    + createdAt : Date
    --
    + register()
    + login()
    + updateProfile()
  }

  class ThongTinKhachThue <<Embedded>> {
    + cccd : String
    + ngheNghiep : String
    + diaChiThuongTru : String
  }

  class Otp <<Embedded>> {
    + maOtp : String
    + hanSuDung : Date
  }

  User "1" *-- "0..1" ThongTinKhachThue : embedded
  User "1" *-- "0..1" Otp : embedded
}

' ========== PACKAGE 2: NHÀ TRỌ & PHÒNG ==========
package "2. Nhà trọ & Phòng" #FFF6E5 {

  class Property {
    + _id : ObjectId
    + maNhaTro : String  <<unique>>
    + tenNhaTro : String
    + diaChi : String
    + quanHuyen : String
    + thanhPho : String
    + hinhAnh : String
    + qrCodeUrl : String
    + tongSoPhong : Number
    + soPhongDaThue : Number
    + maQuanLyIds : ObjectId[]   <<N–N với User>>
    + maChuTroId : ObjectId       <<→ User>>
    + trangThai : enum {active, inactive}
  }

  class RoomType {
    + _id : ObjectId
    + maNhaTroId : ObjectId  <<→ Property>>
    + tenLoai : String
    + dienTich : Number
    + giaCoBan : Number
    + tienNghi : String[]
  }

  class Room {
    + _id : ObjectId
    + maNhaTroId : ObjectId  <<→ Property>>
    + maLoaiPhongId : ObjectId  <<→ RoomType>>
    + soPhong : String
    + tang : Number
    + giaThueHienTai : Number
    + dienTich : Number
    + trangThai : enum {empty, rented, deposit, maintenance}
    + hinhAnh : String[]
    + moTa : String
    + currentTenantId : ObjectId
  }

  class TaiSan <<Embedded>> {
    + tenTaiSan : String
    + giaTri : Number
    + tinhTrang : String
  }

  Property "1" *-- "*" Room
  RoomType "1" -- "*" Room
  Property "1" -- "*" RoomType
  Room "1" *-- "*" TaiSan : embedded
  Property "*" -- "*" User : (Manager phụ trách)
}

' ========== PACKAGE 3: HỢP ĐỒNG ==========
package "3. Hợp đồng & Khách thuê" #E6F5EA {

  class Contract {
    + _id : ObjectId
    + maPhongId : ObjectId  <<→ Room>>
    + maKhachThueIds : ObjectId[]  <<→ User>>
    + ngayBatDau : Date
    + ngayKetThuc : Date
    + tienCoc : Number
    + trangThai : enum {draft, active, expired, terminated}
    + duongDanPdf : String
  }

  Contract "*" -- "1" Room
  Contract "*" -- "*" User : (khách thuê)
}

' ========== PACKAGE 4: DỊCH VỤ & HOÁ ĐƠN ==========
package "4. Dịch vụ & Hoá đơn" #FBE6F1 {

  class Service {
    + _id : ObjectId
    + maNhaTroId : ObjectId  <<→ Property>>
    + tenDichVu : String
    + donVi : String
    + donGia : Number
    + loaiTinh : enum {metered, fixed}
  }

  class Reading {
    + _id : ObjectId
    + maPhongId : ObjectId  <<→ Room>>
    + maDichVuId : ObjectId  <<→ Service>>
    + kyThanhToan : String  <<YYYY-MM>>
    + chiSoCu : Number
    + chiSoMoi : Number
    + tieuThu : Number
  }

  class Invoice {
    + _id : ObjectId
    + maHopDongId : ObjectId  <<→ Contract>>
    + maPhongId : ObjectId  <<→ Room>>
    + kyThanhToan : String
    + tongTien : Number
    + hanThanhToan : Date
    + trangThai : enum {pending, paid, overdue, cancelled}
  }

  class ChiTietHoaDon <<Embedded>> {
    + maDichVuId : ObjectId
    + tenDichVu : String
    + soLuong : Number
    + donGia : Number
    + thanhTien : Number
  }

  class Payment {
    + _id : ObjectId
    + maHoaDonId : ObjectId  <<→ Invoice>>
    + phuongThuc : enum {vnpay, momo, cash, bank_transfer}
    + soTien : Number
    + ngayGiaoDich : Date
    + trangThai : enum {pending, success, failed}
  }

  Property "1" -- "*" Service
  Room "1" -- "*" Reading
  Reading "*" -- "1" Service
  Contract "1" -- "*" Invoice
  Invoice "1" *-- "*" ChiTietHoaDon : embedded
  Invoice "1" -- "*" Payment
}

' ========== PACKAGE 5: THÔNG BÁO ==========
package "5. Thông báo" #E6F0FA {

  class Notification {
    + _id : ObjectId
    + maNguoiDungId : ObjectId  <<→ User>>
    + tieuDe : String
    + noiDung : String
    + kenh : enum {email, sms, zalo, push}
    + daDoc : Boolean
  }

  User "1" -- "*" Notification
}

@enduml
