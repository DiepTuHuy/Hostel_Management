@startuml Seq_Payment_Online
title Hình 2.16 — Tuần tự: UC27 Thanh toán hoá đơn online (v1 giả lập VietQR / v2 VNPay thật)

skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #E0F2F1
skinparam ParticipantBorderColor #00695C
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #3A5BC7

actor    "Khách thuê"  as Tenant
boundary "InvoicesPage" as UI
control  "PaymentCtrl\n(server.js)" as Pay
entity   "MongoDB"     as DB
boundary "VNPay Gateway\n(v2 — định hướng)" as VNP

Tenant -> UI : Chọn hoá đơn pending → "Thanh toán"
UI -> Tenant : Hiển thị VietQR động (số tiền + nội dung CK)

alt v1 — Giả lập (đang triển khai)
  UI -> Pay : POST /api/invoices/:id/pay {method:'vnpay'}
  Pay -> DB : Invoice.update(trangThai:'paid')
  Pay -> DB : Payment.create(phuongThuc:'vnpay',\nsoTien, trangThai:'success')
  Pay --> UI : 200 {success:true}
  UI --> Tenant : Toast "Thanh toán thành công"
else v2 — Tích hợp VNPay thật (định hướng)
  UI -> Pay : Tạo đơn thanh toán
  Pay -> VNP : createOrder(amount, ref) + HMAC-SHA512
  VNP --> Pay : paymentUrl
  Pay --> UI : 302 redirect VNPay
  Tenant -> VNP : Quét QR / nhập thẻ + OTP ngân hàng
  VNP -> Pay : IPN callback /api/payments/vnpay/ipn
  Pay -> Pay : Verify chữ ký HMAC
  Pay -> DB : Invoice='paid' + Payment(success)
  Pay --> Tenant : Trang biên lai PDF
end

@enduml
