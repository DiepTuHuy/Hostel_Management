@startuml Seq_Payment_Online
title Hình 2.16 — Tuần tự: UC26 Thanh toán hoá đơn online (VNPay Sandbox thật / VietQR chuyển khoản)

skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #E0F2F1
skinparam ParticipantBorderColor #00695C
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #3A5BC7

actor    "Khách thuê"  as Tenant
boundary "InvoicesPage" as UI
control  "PaymentCtrl\n(invoice/paymentRoutes)" as Pay
entity   "MongoDB"     as DB
boundary "VNPay Gateway\n(Sandbox)" as VNP

Tenant -> UI : Chọn hoá đơn pending → "Thanh toán"

alt Ví VNPay — đã tích hợp thật (Sandbox)
  UI -> Pay : POST /api/invoices/:id/pay {method:'vnpay'}
  Pay -> Pay : vnpayService.createPaymentUrl\n(ký HMAC-SHA512: orderId, amount, orderInfo)
  Pay --> UI : 200 {paymentUrl}
  UI --> Tenant : Chuyển hướng sang cổng VNPay
  Tenant -> VNP : Quét QR / nhập thẻ + OTP ngân hàng
  VNP -> Pay : GET /api/payments/vnpay-return\n(+ IPN /api/payments/vnpay-ipn)
  Pay -> Pay : verifyCallback — kiểm chữ ký HMAC
  Pay -> DB : Invoice='paid' + Payment.create\n(phuongThuc:'vnpay', trangThai:'success')
  Pay --> Tenant : Redirect PaymentReturnPage\n(biên lai điện tử, đối soát kết quả)
else Chuyển khoản — VietQR động
  UI -> Tenant : Hiển thị VietQR động (số tiền + nội dung CK)
  Tenant -> UI : Quét QR app ngân hàng → Xác nhận đã CK
  UI -> Pay : POST /api/invoices/:id/pay {method:'bank_transfer'}
  Pay -> DB : Invoice='paid' + Payment.create\n(phuongThuc:'bank_transfer')
  Pay --> UI : 200 {success:true}
  UI --> Tenant : Toast "Thanh toán thành công"
else Tiền mặt — chờ Quản lý xác nhận
  UI -> Pay : POST /api/invoices/:id/pay {method:'cash'}
  Pay -> DB : Invoice.update(trangThai:'pending_cash')
  Pay --> UI : "Đang chờ Quản lý xác nhận"
  note over Pay, DB : Quản lý xác nhận tại /manager/cash-receipts\nPOST /api/invoices/:id/pay-cash → 'paid'\n(hoặc reject-cash → trả về 'pending')
end

@enduml
