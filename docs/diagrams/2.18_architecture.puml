@startuml Architecture_Deployment
title Hình 2.18 — Kiến trúc triển khai thực tế (3 tầng)

skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam componentStyle rectangle
skinparam ArrowColor #34507A
skinparam component {
  BackgroundColor #FAFCFF
  BorderColor #3A5BC7
}
skinparam node {
  BackgroundColor #EEF3FC
  BorderColor #1F3864
}
skinparam cloud {
  BackgroundColor #FFF6E5
  BorderColor #E59300
}
skinparam database {
  BackgroundColor #E6F5EA
  BorderColor #2E7D32
}

actor "Người dùng\n(Admin · Manager · Tenant · Visitor)" as User

node "Tầng Giao diện — Trình duyệt" as N1 {
  component "React 18 SPA  ·  Vite (port 5173)\n4 phân hệ dashboard · AIChatbot widget\nReact Router · Tailwind · Recharts" as FE
}

node "Tầng API — Node.js" as N2 {
  component "Express Server (port 5001)\n58 REST endpoints · JWT middleware\nMongoose ODM · Fallback Engine" as BE
  component "Python Flask (port 5002)\nmodule thống kê — tuỳ chọn,\nKHÔNG được frontend gọi" as FL
}

database "MongoDB Atlas\nboardinghouse_db\n10 collections" as DB

cloud "Google Gemini\n2.5 Flash API" as GEM
cloud "Gmail SMTP\nsmtp.gmail.com:587" as SMTP

User --> FE : HTTPS
FE --> BE : REST API (axios)
BE --> DB : Mongoose driver\n(DNS 8.8.8.8 — bypass IPv6 SRV)
BE --> GEM : POST generateContent\n(3 lần retry · backoff 600ms)
BE --> SMTP : 4 luồng email\n(OTP đăng ký/quên MK · hợp đồng · nhắc nợ)
FL ..> DB : (tuỳ chọn)

note bottom of N2
  Khởi chạy 3 tiến trình riêng:
  npm start (Express 5001) · npm run dev (Vite 5173)
  · python run.py (Flask 5002 — tuỳ chọn).
end note

@enduml
