@startuml Act_Contract_Sign
title Hình 2.9 — Hoạt động: Lập hợp đồng & Ký số (giả lập)

skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #34507A
skinparam activity {
  BackgroundColor #E6F5EA
  BorderColor #2E7D32
  DiamondBackgroundColor #FFF6E5
  DiamondBorderColor #E59300
  StartColor #2E7D32
  EndColor #AD1457
}

|#ECF7EF|Quản lý|
start
:Vào /manager/contracts → "Tạo hợp đồng";
:Chọn phòng trống (trangThai='empty');

|#EAF1FB|Frontend|
if (Khách đã có hồ sơ?) then (có)
  :Chọn từ danh sách khách thuê;
else (chưa)
  :Nhập khách mới\n(họ tên, email, SĐT, CCCD);
endif
:Nhập điều khoản\n(ngày bắt đầu/kết thúc, cọc, giá, dịch vụ);
:Nhấn "Tạo hợp đồng";

|#EAF1FB|Backend Express|
:POST /api/contracts;
if (Khách chưa có User?) then (có)
  :Tạo User mới\n(mật khẩu mặc định "123456");
endif
:Tạo Contract (trangThai="active",\nduongDanPdf = URL PDF);
:Room.trangThai="rented"\n+ currentTenantId;
:Property.soPhongDaThue +1;
:Gửi email thông báo hợp đồng\n(sendContractNotificationEmail);

|#ECF7EF|Khách thuê|
:Đăng nhập /tenant/contract;
:Xem PDF + điều khoản;
if (Đồng ý?) then (có)
  :Nhấn "Ký số";
  :PATCH /api/contracts/:id/sign;
  |#EAF1FB|Backend Express|
  :Contract.trangThai = "active"\n(v1: chỉ đổi trạng thái,\nKHÔNG yêu cầu OTP);
  note right
    v2 (định hướng): nhúng chữ ký
    vẽ tay / CA vào file PDF.
  end note
  stop
else (từ chối)
  :Contract → "cancelled"\nRoom → "empty";
  stop
endif

@enduml
