@startuml Act_Payment
title Hình 2.11 — Hoạt động: Thanh toán hoá đơn (VNPay Sandbox / Chuyển khoản VietQR / Tiền mặt)

skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #34507A
skinparam activity {
  BackgroundColor #E0F2F1
  BorderColor #00695C
  DiamondBackgroundColor #FFF6E5
  DiamondBorderColor #E59300
  StartColor #2E7D32
  EndColor #AD1457
}

|#E8F6F5|Khách thuê|
start
:Đăng nhập /tenant/invoices;
:Chọn hoá đơn cần thanh toán;
:Mở modal "Chọn phương thức";

switch (Phương thức?)
case (Ví VNPay — Sandbox thật)
  |#EAF1FB|Frontend|
  :POST /api/invoices/:id/pay\n{method:'vnpay'};
  |#E6F2F1|Backend Express|
  :vnpayService.createPaymentUrl\n(ký HMAC-SHA512) → paymentUrl;
  |#E8F6F5|Khách thuê|
  :Chuyển hướng sang cổng VNPay,\nquét QR / nhập thẻ + OTP ngân hàng;
  |#E6F2F1|Backend Express|
  :GET /api/payments/vnpay-return\n(verify chữ ký HMAC);
  :Invoice = 'paid'\n+ Payment {phuongThuc:'vnpay'};
  note right
    Đã tích hợp thật (VNPay Sandbox):
    sinh URL ký HMAC-SHA512, callback
    vnpay-return + vnpay-ipn đối soát,
    trang kết quả PaymentReturnPage.
  end note
case (Chuyển khoản — VietQR)
  |#EAF1FB|Frontend|
  :Hiển thị VietQR động\n(số tiền + nội dung CK);
  |#E8F6F5|Khách thuê|
  :Quét VietQR, chuyển khoản\nqua app ngân hàng;
  |#E6F2F1|Backend Express|
  :POST /api/invoices/:id/pay\n{method:'bank_transfer'}\n→ 'paid' + Payment;
case (Tiền mặt)
  |#E6F2F1|Backend Express|
  :POST /api/invoices/:id/pay\n{method:'cash'}\n→ Invoice = 'pending_cash';
  |#FFF9EC|Quản lý|
  :Vào /manager/cash-receipts;
  :Chọn hoá đơn → "Xác nhận thu"\n(hoặc "Từ chối");
  |#E6F2F1|Backend Express|
  :POST /api/invoices/:id/pay-cash;
  :Invoice = 'paid'\n+ Payment {phuongThuc:'cash'};
endswitch

|#EAF1FB|Frontend|
:Hiển thị Toast + biên lai điện tử;
stop

@enduml
