@startuml Act_Register_OTP
title Hình 2.7 — Hoạt động: Đăng ký tài khoản & Kích hoạt OTP qua Email

skinparam dpi 150
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam ArrowColor #34507A
skinparam activity {
  BackgroundColor #EEF3FC
  BorderColor #3A5BC7
  DiamondBackgroundColor #FFF6E5
  DiamondBorderColor #E59300
  StartColor #2E7D32
  EndColor #AD1457
}

|#F4F8FF|Người dùng|
start
:Truy cập trang Đăng ký (/register);
:Nhập họ tên, email, SĐT,\nmật khẩu, nhập lại mật khẩu;
:Nhấn "Đăng ký";

|#EAF1FB|Backend Express|
:Kiểm tra email / SĐT chưa tồn tại;
if (Hợp lệ?) then (đúng)
  :Mã hoá mật khẩu (bcryptjs);
  :Sinh OTP 6 chữ số\n(hiệu lực 5 phút);
  :Tạo User trạng thái "pending"\nkèm OTP;
  :Gửi email OTP\n(Nodemailer · Gmail SMTP);
else (lỗi)
  :Trả lỗi xác thực;
  stop
endif

|Người dùng|
:Nhận email, nhập 6 ô OTP;
:Nhấn "Xác nhận";

|Backend Express|
if (OTP đúng và còn hạn?) then (có)
  :User.trangThai = "active";
  :Xoá OTP khỏi DB;
  :Cấp JWT phiên làm việc;
  |Người dùng|
  :Tự động đăng nhập\n→ dashboard theo vai trò;
  stop
else (sai / hết hạn)
  :Cho phép gửi lại OTP\n(POST /api/auth/resend-otp);
  stop
endif

@enduml
