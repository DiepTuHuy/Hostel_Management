@startuml Act_Register_OTP
title Hình 2.7 — Sơ đồ hoạt động UC Đăng ký tài khoản & Kích hoạt OTP qua Email

skinparam shadowing false
skinparam activity {
  BackgroundColor #F5F7FB
  BorderColor #3A5BC7
  DiamondBackgroundColor #FFF6E5
  DiamondBorderColor #E59300
}

|Người dùng|
start
:Truy cập trang Đăng ký /register;
:Nhập họ tên, email, số điện thoại,\nmật khẩu, nhập lại mật khẩu;
:Nhấn "Đăng ký";

|Backend Express|
:Kiểm tra ràng buộc (email/SĐT chưa tồn tại);
if (Hợp lệ?) then (Đúng)
  :Mã hoá mật khẩu bcryptjs;
  :Sinh mã OTP 6 chữ số\n(hiệu lực 5 phút);
  :Tạo bản ghi User trạng thái\n"pending" kèm OTP;
  :Gửi email OTP qua\nNodemailer Gmail SMTP;
else (Lỗi)
  :Trả lỗi xác thực;
  stop
endif

|Người dùng|
:Nhận email + nhập 6 ô OTP;
:Nhấn "Xác nhận";

|Backend Express|
:Kiểm tra OTP & hạn dùng;
if (OTP đúng và còn hạn?) then (Có)
  :Cập nhật User.trangThai = "active";
  :Xoá OTP khỏi DB;
  :Cấp JWT phiên làm việc;

  |Người dùng|
  :Tự động đăng nhập;
  :Chuyển dashboard theo vai trò;
  stop
else (Sai/hết hạn)
  :Cho phép gửi lại OTP\n(POST /api/auth/resend-otp);
  stop
endif

@enduml
