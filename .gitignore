# ==========================================================
# Boarding House Chain Management System - Git Ignore Rules
# ==========================================================

# 1. Ignore everything at the root level by default
/*

# 2. Allow only specified directories and README at the root
!/.gitignore
!/README.md
!/src/
!/tests/
!/docs/

# ==========================================================
# Rules for files inside allowed directories
# ==========================================================

# Node / JS dependencies and builds
**/node_modules/
**/dist/
**/dist-ssr/
**/.vite/

# Python virtual environment and cache
**/.venv/
**/__pycache__/
**/*.pyc

# Local environment variables
**/.env
**/.env.local
**/.env.*.local

# IDE, OS, Temp and lock files
**/.DS_Store
**/Thumbs.db
**/desktop.ini
**/*.tmp
**/*.log
**/~$*.docx
**/~$*.xlsx

# Temporary Vite launcher scripts
src/frontend/start-vite.js
src/frontend/strip-comments.js

# Backup directories
docs/backup_original_*/


